# THE LOOPS UNIVERSAL RETAIL ECOSYSTEM — CENTRALIZED ENVIRONMENT CONFIGURATION

# Gateway & Public Entrypoint
GATEWAY_PORT=5000
NODE_ENV=development

# Microservices Backend Ports
STOCK_API_PORT=3000
FINANCE_API_PORT=3001
POS_API_PORT=3002

# Microservices URLs
STOCK_API_URL=http://localhost:3000
FINANCE_API_URL=http://localhost:3001
POS_API_URL=http://localhost:3002

# Unified Web Application Frontend Port
FRONTEND_PORT=5175

# Platform Constants
DEFAULT_CURRENCY=USD
SECONDARY_CURRENCY=KHR
DEFAULT_EXCHANGE_RATE=4000
ORGANIZATION_NAME="THE LOOP.S Retail"


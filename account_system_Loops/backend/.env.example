# ============================================================================
# Loops Finance V3 — Environment Configuration
# ============================================================================

# HTTP Server Port
PORT=3001

# MySQL Database Configuration
# If MySQL connection fails or is not configured, Loops Finance automatically runs in
# resilient local data mode without crashing, allowing full development & testing.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=loops_finance

# Base Currency
BASE_CURRENCY=USD

# Stock Management Loops Bridge URL
STOCK_LOOPS_API_URL=http://localhost:3000/api

